# Cash availability provider configuration
# Keep the real .env file private and never expose these values to Vite.
API_PORT=8788
ATM_PROVIDER_URL=
ATM_PROVIDER_API_KEY=
ATM_PROVIDER_AUTH_HEADER=Authorization
ATM_PROVIDER_AUTH_PREFIX=Bearer
ATM_PROVIDER_TIMEOUT_MS=8000
SESSION_TTL_MS=28800000
API_RATE_LIMIT=120
# Set this to the browser origin in production, for example https://app.example.com
CORS_ORIGIN=http://localhost:5173

# Twilio Verify for customer registration OTP SMS. Without these the OTP is printed in the API console.
# Console: https://console.twilio.com -> Account SID / Auth Token; Verify -> Services -> Service SID (starts with VA)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
